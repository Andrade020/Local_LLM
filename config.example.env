# LocalLLM Configuration File


# llama-server.exe do llama.cpp (https://github.com/ggml-org/llama.cpp/releases)
# GPU NVIDIA GTX 10xx (Pascal): use o build "win-cuda-12.4" (o CUDA 13 não suporta mais Pascal)
# Sem GPU NVIDIA: build "win-vulkan" ou "win-cpu"
LLAMA_SERVER_PATH=llama.cpp/llama-server.exe

# Path to your GGUF model file
# Example: models/Qwen3.6-35B-A3B-UD-IQ3_XXS.gguf
MODEL_PATH=models/your_model.gguf

# Hardware (llama-server)
# N_GPU_LAYERS: camadas na GPU (99 = todas, 0 = só CPU)
# N_CPU_MOE: em modelos MoE, quantas camadas mantêm os experts na CPU.
#   Com pouca VRAM, use N_GPU_LAYERS=99 e N_CPU_MOE = nº de camadas do modelo (ex.: 40),
#   e vá diminuindo enquanto couber na VRAM.
N_GPU_LAYERS=0
N_CPU_MOE=0
N_CTX=8192
N_THREADS=
# Argumentos extras para o llama-server (opcional)
LLAMA_SERVER_EXTRA_ARGS=

# Modo de raciocínio (thinking) dos modelos Qwen3.x: true/false
ENABLE_THINKING=true

# Inference parameters (valores recomendados para Qwen3.x)
DEFAULT_TEMPERATURE=0.6
DEFAULT_TOP_P=0.95
DEFAULT_MAX_TOKENS=4096
DEFAULT_REPEAT_PENALTY=1.0

# System settings
CACHE_DIR=cache
LOG_LEVEL=INFO
LOG_FILE=app.log

# Memory settings (MB)
# Set to 0 for auto-detection
MAX_RAM_MB=0

# UI settings
THEME=default
FONT_SIZE=10

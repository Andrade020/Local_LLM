# LocalLLM Configuration File


# Path to your GGML/GGUF model file
# Example: models/llama-2-7b-chat.Q4_0.gguf
MODEL_PATH=models/llama-2-7b-chat.Q4_K_M.gguf

# Inference parameters
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
DEFAULT_MAX_TOKENS=512
DEFAULT_REPEAT_PENALTY=1.1

# System settings
CACHE_DIR=cache
LOG_LEVEL=INFO
LOG_FILE=app.log

# Memory settings (MB)
# Set to 0 for auto-detection
MAX_RAM_MB=0

# UI settings
THEME=default
FONT_SIZE=10